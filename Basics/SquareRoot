import math
x = int(input("Enter the Number To Determine Square Root: "))
estimate = 1
tolerance = 0.000001
while True:
    estimate = (estimate +(x/estimate))/2
    diff = abs(x-estimate**2)
    if(diff<=tolerance):
        break
print("Approx Square Root : ",estimate)
print("Square Root : ",math.sqrt(x))
